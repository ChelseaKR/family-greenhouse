#!/usr/bin/env sh
# TOMBSTONE — this file is no longer the pre-push gate.
#
# The hooks moved to the TRACKED `.githooks/` directory and `core.hooksPath`
# now points there (#544). This file exists only to catch the transition
# window: a checkout that pulled the move but has NOT re-run `npm install`
# still has `core.hooksPath=.husky/_`, and husky's shim exits 0 when the
# script it sources is absent. Deleting this file outright would therefore
# reproduce the exact defect the move was made to close — a missing file
# rendered as a clean push.
#
# So it fails loudly instead. Remove `.husky/` entirely once every checkout
# has run `npm ci` at least once on a commit containing `.githooks/`.
echo "pre-push: BLOCKED — this checkout's git hooks are stale." >&2
echo "" >&2
echo "The pre-push gate moved from .husky/ to the tracked .githooks/ directory" >&2
echo "(#544), and core.hooksPath in this checkout still points at .husky/_ ." >&2
echo "Re-wire it — one command, and \`npm ci\` does it too:" >&2
echo "" >&2
echo "  npm run hooks:install" >&2
echo "" >&2
echo "Then push again. Refusing rather than passing, because a hook that cannot" >&2
echo "find its script is exactly the silent no-op this move removed." >&2
exit 1
