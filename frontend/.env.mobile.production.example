# These are public client configuration values, kept here so every archive is
# reproducible. Copy to .env.mobile.production; that local file is gitignored.
VITE_API_URL=https://ux8jg1lns0.execute-api.us-east-1.amazonaws.com/production
VITE_COGNITO_USER_POOL_ID=us-east-1_ByXmW6yOy
VITE_COGNITO_CLIENT_ID=700a0dcq5cl94f4hhllmc1ib9d
VITE_COGNITO_REGION=us-east-1
VITE_BETA_MODE=false

# Native push notifications, two switches (docs/native-push-setup.md §5).
# Both stay false here; set them ONLY in the local .env.mobile.production.
#   VITE_NATIVE_PUSH_ENABLED=true turns push on for iOS (the APNs steps done).
#   VITE_NATIVE_PUSH_ANDROID_ENABLED=true also turns it on for Android, and
#   needs frontend/android/app/google-services.json (the Firebase steps done);
#   while it is false an Android shell never loads the push plugin.
# scripts/validate-store-release.mjs fails this template if either is not
# false, and fails a --production build that sets the Android switch true
# without the Android file.
VITE_NATIVE_PUSH_ENABLED=false
VITE_NATIVE_PUSH_ANDROID_ENABLED=false

# Optional. Leave unset to use the synchronous chat API.
# VITE_CHAT_STREAM_URL=https://example.lambda-url.us-east-1.on.aws/

# Optional. The production PostHog project key (the same value as the
# PRODUCTION_POSTHOG_KEY repository secret). Unset, the app still records
# first-party product events to our own API; only the PostHog rail is off.
# The iOS privacy manifest declares analytics either way.
# VITE_POSTHOG_KEY=phc_...

# Never set VITE_GA_MEASUREMENT_ID here. Google Analytics is website-only and
# the App Privacy answers do not cover it; scripts/validate-store-release.mjs
# fails a template or a store build that sets it.
