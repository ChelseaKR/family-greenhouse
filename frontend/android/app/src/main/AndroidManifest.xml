<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- android-app-links:start. Generated by frontend/scripts/build-asset-links.mjs from ROUTE_POLICY; regenerate with npm run aasa, never hand-edit. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="familygreenhouse.net" />
                <data android:path="/account" />
                <data android:path="/analytics" />
                <data android:path="/away-recap" />
                <data android:pathPrefix="/caretaker/" />
                <data android:path="/chat" />
                <data android:path="/dashboard" />
                <data android:path="/household" />
                <data android:pathPrefix="/household/" />
                <data android:pathPrefix="/join/" />
                <data android:pathPrefix="/kiosk/" />
                <data android:path="/onboarding" />
                <data android:path="/plants" />
                <data android:pathPrefix="/plants/" />
                <data android:pathPattern="/plants/.*/passport" />
                <data android:path="/settings" />
                <data android:pathPrefix="/settings/" />
                <data android:pathPrefix="/shared/" />
                <data android:pathPrefix="/sit/" />
                <data android:pathPattern="/sit/.*/brief" />
                <data android:pathPrefix="/tag/" />
                <data android:path="/tags" />
                <data android:path="/tasks" />
                <data android:path="/today" />
            </intent-filter>
            <!-- android-app-links:end -->

        </activity>

        <!-- Native push (docs/native-push-setup.md): the small icon Android
             draws for a notification. It must be a single-color silhouette,
             which the launcher's monochrome layer already is; without it
             Android draws the app icon as a white square. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_launcher_monochrome" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Plant photos are chosen through the Android Photo Picker
             (@capacitor/camera chooseFromGallery), which hands the app only
             the photo the person picked and needs no storage permission. This
             entry asks Google Play services to install the backported picker
             on Android 11 and 12 devices that do not have it built in; without
             it they fall back to the system document picker, which also needs
             no permission. -->
        <service android:name="com.google.android.gms.metadata.ModuleDependencies"
            android:enabled="false"
            android:exported="false"
            tools:ignore="MissingClass">
            <intent-filter>
                <action android:name="com.google.android.gms.metadata.MODULE_DEPENDENCIES" />
            </intent-filter>
            <meta-data android:name="photopicker_activity:0:required" android:value="" />
        </service>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+: asked only when the person taps "Turn on notifications"
         (NativePushPrompt, Settings → Notifications), never at launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
