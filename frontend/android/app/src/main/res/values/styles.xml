<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- Light, not DayNight: the web app has no dark theme, so a night-mode
         window background only ever showed as dark bands above and below a
         light page (older WebViews are padded inside the system bars rather
         than drawn under them) and as dark native pickers over it. Paper is
         the page's own background color. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/fgPaper</item>
        <!-- Dark status and navigation bar icons, for the same reason. The
             splash screen's exit reapplies these from the theme, after any
             SystemBars.setStyle call made while it was still showing, so
             leaving them unset put white icons on the paper header. -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <!-- Android 12+ draws its own launch screen from these, not from
             android:background: the app icon on the same forest green as the
             iOS launch screen, held by @capacitor/splash-screen until the
             first route renders. -->
        <item name="windowSplashScreenBackground">@color/fgForest</item>
        <item name="android:statusBarColor">#173404</item>
        <item name="android:navigationBarColor">#173404</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
