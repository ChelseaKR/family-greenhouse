{
  "name": "family-greenhouse",
  "version": "0.25.0",
  "license": "Elastic-2.0",
  "private": true,
  "description": "A shared plant-care journal for the whole household — per-plant schedules, reminders that find the right person across browser/email/SMS, and a care log everyone can see. React + TypeScript on AWS Lambda + DynamoDB + Cognito.",
  "keywords": [
    "plant-care",
    "houseplants",
    "gardening",
    "plant-tracker",
    "plant-reminder",
    "watering-reminder",
    "household",
    "family",
    "pwa",
    "react",
    "typescript",
    "serverless",
    "aws-lambda",
    "dynamodb",
    "terraform"
  ],
  "homepage": "https://familygreenhouse.net",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChelseaKR/family-greenhouse.git"
  },
  "bugs": {
    "url": "https://github.com/ChelseaKR/family-greenhouse/issues"
  },
  "author": "Chelsea Kelly-Reif",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "prepare": "husky",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "eval": "npm run eval --workspace backend",
    "i18n:check": "npm run i18n:check --workspace frontend",
    "reads:check": "npm run reads:check --workspaces --if-present",
    "mobile:validate": "node scripts/validate-store-release.mjs",
    "observability:check": "node scripts/check-observability.mjs",
    "api:check": "node scripts/check-api-spec.mjs",
    "sitemap:check": "npm run sitemap:check --workspace frontend",
    "brand:check": "npm run brand:check --workspace frontend",
    "figures:check": "node scripts/check-doc-figures.mjs",
    "mobile:release": "frontend/scripts/build-mobile-release.sh",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run i18n:check && npm run reads:check && npm run observability:check && npm audit --omit=dev --audit-level=high && node scripts/check-no-bare-markers.mjs && node scripts/check-no-silenced-gates.mjs && node scripts/check-docs-testing.mjs && npm run figures:check && npm run api:check && npm run sitemap:check && npm run brand:check"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "husky": "^9.0.11",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  },
  "lint-staged": {
    "backend/src/**/*.ts": [
      "eslint --fix"
    ],
    "frontend/src/**/*.{ts,tsx}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "tmp": "^0.2.6",
    "esbuild": "^0.28.2",
    "js-yaml": "^4.3.1",
    "uuid": "^14.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  },
  "engines": {
    "node": ">=22.22.0",
    "npm": ">=10.0.0"
  }
}
